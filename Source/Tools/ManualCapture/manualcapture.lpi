      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11" />
    <Target>
      <Filename Value="build/manualcapture" />
    </Target>
    <SearchPaths>
      <OtherUnitFiles Value="../..;../../VCL/ClassBrowsing;../../VCL/devFileMonitor;../../VCL/devShortcuts;../../VCL/CompOptionsList" />
